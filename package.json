{
  "name": "cliedit",
  "version": "0.5.1",
  "description": "A zero-dependency, embeddable TUI text editor for Node.js CLI applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeTease/cliedit.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "demo": "bun run build && cross-env NODE_ENV=development bun src/demo.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "keywords": [
    "cli",
    "editor",
    "terminal",
    "tui",
    "raw-mode",
    "typescript"
  ],
  "author": "CodeTease",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.73.0"
  }
}
